DEBUGOPTS +=
PLATFLAGS += -DAMBAAXISYNBUILD -DWITHOUT_OCP
INCDIR    += -I$(SWARMDIR)/amba-axi-syn -I$(SWARMDIR)/amba-axi-syn/dw_amba_axi_aux
CPPSRCS   += Master_axi.cpp Slave_axi.cpp amba_axi_dma.cpp \
             DW_AXI_Arbiter.cpp DW_AXI_Decoder.cpp DW_AXI_IC.cpp DW_AXI_SimpleSlave.cpp
LIBDIR    += -L$(SYNOPSYS_SIM)/linux/ccss/lib -L$(SYNOPSYS_SIM)/linux/ccss/dw_amba_sc/lib/
LIBS      += -ldw_amba_axi-g -ldw_amba_axi_aux-O -ltcl-O -lvirvpd-O -ldl -lcstubrh9 \
             -lclm-O -lruntimelib-O -lruntimelibsc-O -lg2c
VPATH     += $(SWARMDIR)/amba-axi-syn $(SWARMDIR)/amba-axi-syn/dw_amba_axi_aux
#String to print during build process
MSGSTRING += "AMBA AXI (Synopsys model)   "
SYSTEMC   := $(SYN_SYSTEMC)

amba-syn-axi: printmessage $(EXE)
