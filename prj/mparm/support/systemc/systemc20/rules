#!/usr/bin/make -f
# -*- makefile -*-

include /usr/share/cdbs/1/rules/debhelper.mk
include /usr/share/cdbs/1/rules/simple-patchsys.mk
include /usr/share/cdbs/1/class/autotools.mk

DEB_MAKE_BUILD_TARGET := -C src all CXXFLAGS="-O3 -Wall -DSC_INCLUDE_FX -Wno-deprecated"
DEB_MAKE_INSTALL_TARGET := -C src install prefix=$(CURDIR)/debian/libsystemc20-dev/usr
DEB_MAKE_CLEAN_TARGET := clean
DEB_COMPRESS_EXCLUDE := .pdf

install/libsystemc20-dev::
	mv $(CURDIR)/debian/libsystemc20-dev/usr/lib-linux $(CURDIR)/debian/libsystemc20-dev/usr/lib
	mv $(CURDIR)/debian/libsystemc20-dev/usr/lib/libsystemc.a $(CURDIR)/debian/libsystemc20-dev/usr/lib/libsystemc20.a
	install -d -m 755 $(CURDIR)/debian/libsystemc20-dev/usr/include/systemc-2.0
	-mv $(CURDIR)/debian/libsystemc20-dev/usr/include/* $(CURDIR)/debian/libsystemc20-dev/usr/include/systemc-2.0
	install -d -m 755 $(CURDIR)/debian/libsystemc20-dev/usr/share/doc/libsystemc20-dev
	install -m 644 $(CURDIR)/docs/*.pdf $(CURDIR)/debian/libsystemc20-dev/usr/share/doc/libsystemc20-dev
