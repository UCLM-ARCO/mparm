+bool
+sc_cthread_process::ready_to_run()
+{
+    bool exception = eval_watchlist();
+    if( exception ) {
+	return true;
+    }
+
+    bool ready;
+    switch( m_wait_state ) {
+    case CLOCK:
+        ready = ( -- m_wait_cycles == 0 );
+        break;
+    case LAMBDA:
+        ready = m_wait_lambda->eval();
+        break;
+    default:
+        ready = true;
+        break;
+    }
+    return ready;
+}
