# Some defaults for my setup
prefix=/home/paco/devel/mparm/apps/icee
CXX=arm-elf-g++
CC=arm-elf-g++
LD=arm-elf-ld
AR=arm-elf-ar


USE_SPARC_ASM		= irrelevant
MACHINE			= $(shell uname -m)

OPT_FLAGS		=
ifeq ($(OPTIMIZE_SPEED),yes)
  OPT_FLAGS		= -O3
endif
ifeq ($(OPTIMIZE_SIZE),yes)
  OPT_FLAGS		= -Os
endif

#
# Default compiler is c++ (aka g++).
#
ifeq ($(CXX),)
   CXX			= c++
endif

ifeq ($(CXX),g++)
   CXX			= c++
endif


ifeq ($(MACHINE),x86_64)
   #
   # Default build on x86_64 is 64-bit.
   #
   ifeq ($(LP64),)
      LP64      = yes
   endif
endif


CXXFLAGS= $(CXXARCHFLAGS) -ftemplate-depth-128 -Wall -D_REENTRANT \
	-D__linux -D__linux__ -Dlinux -Dunix -D__uClinux__ -DEMBED \
	-DNDEBUG -msoft-float \
	-I/usr/local/arm-elf/include -I/usr/local/arm-elf/stlport
ifeq ($(OPTIMIZE),yes)
  CXXFLAGS		+= $(OPT_FLAGS) -DNDEBUG
else
  CXXFLAGS		+= -g
endif

#
# C++ run-time libraries, necessary for linking some shared libraries.
#
CXXLIBS		=

mkshlib		= $(CXX) -shared $(LDFLAGS) -o $(1) -Wl,-h,$(2) $(3) $(4) -lpthread

mklib		= ar cr $(1) $(2)

LDPLATFORMFLAGS 	= -Wl,-elf2flt -L/usr/local/arm-elf/lib

BASELIBS		= $(STLPORT_LIBS) -lstdc++ -lpthread 
LIBS			= -lIceE $(BASELIBS)
MINLIBS			= -lIceEC $(BASELIBS)
TESTLIBS		= -lTestCommon $(LIBS)

ICEUTIL_OS_LIBS		= 
ICE_OS_LIBS		= -ldl

PLATFORM_HAS_READLINE	= no

export LD_LIBRARY_PATH	:= $(libdir):$(LD_LIBRARY_PATH)
