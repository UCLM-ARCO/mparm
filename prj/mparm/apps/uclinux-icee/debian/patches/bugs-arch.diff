--- zeroc-icee-1.1.0/include/IceE/Config.h~	2006-03-08 19:09:45.000000000 +0100
+++ zeroc-icee-1.1.0/include/IceE/Config.h	2006-04-13 12:54:56.000000000 +0200
@@ -87,7 +87,16 @@
 // Most CPUs support only one endianness, with the notable exceptions
 // of Itanium (IA64) and MIPS.
 //
-#if defined(__i386) || defined(_M_IX86) || defined (__x86_64) || defined (_M_ARM) 
+#if defined(__linux)
+#   include <endian.h>
+#   if __BYTE_ORDER==__LITTLE_ENDIAN
+#      define ICE_LITTLE_ENDIAN
+#   elif __BYTE_ORDER==__BIG_ENDIAN
+#      define ICE_BIG_ENDIAN
+#   else
+#      error "Unknown endian type"
+#   endif
+#elif defined(__i386) || defined(_M_IX86) || defined (__x86_64) || defined (_M_ARM) 
 #   define ICE_LITTLE_ENDIAN
 #elif defined(__sparc) || defined(__sparc__) || defined(__hppa) || defined(__ppc__) || defined(_ARCH_COM)
 #   define ICE_BIG_ENDIAN
@@ -98,7 +107,14 @@
 //
 // 32 or 64 bit mode?
 //
-#if defined(__linux) && defined(__sparc__)
+#if defined(__linux)
+#   include <limits.h>
+#   if __WORDSIZE == 64
+#      define ICE_64
+#   else
+#      define ICE_32
+#   endif
+#elif defined(__linux) && defined(__sparc__)
 //
 // We are a linux sparc, which forces 32 bit usr land, no matter the architecture
 //
