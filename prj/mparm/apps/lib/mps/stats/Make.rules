dat: throughput.dat sem.dat mutex.dat

%.dat:
	cat $^ | $(FILTER) > $@

mutex.dat: FILTER=../filter-mutex-sem.sh
mutex.dat: mutex.scn old.scn

sem.dat:   FILTER=../filter-mutex-sem.sh
sem.dat:   sem.scn old.scn

throughput.dat: FILTER=../filter-throughput.sh
throughput.dat: channel.dat queue.dat ringbuf.dat raw.dat
