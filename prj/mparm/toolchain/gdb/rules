#!/usr/bin/make -f

TARGET := arm-linux-uclibc

DEB_BUILD_OPTIONS := nocheck
DEB_TAR_SRCDIR := gdb-6.4

include /usr/share/cdbs/1/rules/simple-patchsys.mk
include /usr/share/cdbs/1/rules/tarball.mk
include /usr/share/cdbs/1/rules/debhelper.mk
include /usr/share/cdbs/1/class/autotools.mk

DEB_CONFIGURE_EXTRA_FLAGS := --target=$(TARGET) --host=$(DEB_HOST_GNU_TYPE) \
	--disable-nls --without-uiout --disable-tui --disable-gdbtk \
	--without-x --without-included-gettext --enable-threads

DEB_DH_STRIP_ARGS := -Xgdbserver -Xgdbreplay

build/gdb-arm-linux-uclibc::
	cd build-tree/$(DEB_TAR_SRCDIR)/gdb/gdbserver && \
	./configure --host=$(TARGET) --target=$(TARGET) \
	--prefix=/usr --exec-prefix=/usr --bindir=/usr/bin \
	--sbindir=/usr/sbin --libexecdir=/usr/lib \
	--sysconfdir=/etc --datadir=/usr/share \
	--localstatedir=/var --mandir=/usr/man --disable-nls \
	--without-uiout --disable-tui --disable-gdbtk --without-x \
	--without-included-gettext  && \
	make CFLAGS="-Dfork=vfork -DHAVE_UINTPTR_T=1"

binary-install/gdb-arm-linux-uclibc::
	install -d debian/gdb-arm-linux-uclibc/usr/arm-linux-uclibc/target_utils
	install build-tree/$(DEB_TAR_SRCDIR)/gdb/gdbserver/gdbserver debian/gdb-arm-linux-uclibc/usr/arm-linux-uclibc/target_utils/
	install build-tree/$(DEB_TAR_SRCDIR)/gdb/gdbserver/gdbreplay debian/gdb-arm-linux-uclibc/usr/arm-linux-uclibc/target_utils/
	$(RM) debian/gdb-arm-linux-uclibc/usr/lib/*.a
	$(RM) -r debian/gdb-arm-linux-uclibc/usr/share/info
	$(RM) -r debian/gdb-arm-linux-uclibc/usr/share/locale
	$(RM) -r debian/gdb-arm-linux-uclibc/usr/share/man

