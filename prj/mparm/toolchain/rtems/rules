#!/usr/bin/make -f

TARGET := arm-rtems
BSP := mparm edb7312 gba

DEB_TAR_SRCDIR := rtems-4.6.99
DEB_BUILDDIR := build-tree/build
DEB_BUILD_OPTIONS := nocheck nostrip
DEB_CLEAN_EXCLUDE := cfg.P

CFLAGS_FOR_TARGET := -msoft-float
CXXFLAGS_FOR_TARGET := -msoft-float
LDFLAGS_FOR_TARGET := -msoft-float

export DEB_BUILD_OPTIONS DEB_BUILD_DIR DEB_CLEAN_EXCLUDE
export CFLAGS_FOR_TARGET CXXFLAGS_FOR_TARGET LDFLAGS_FOR_TARGET

include /usr/share/cdbs/1/rules/simple-patchsys.mk
include /usr/share/cdbs/1/rules/tarball.mk
include /usr/share/cdbs/1/rules/debhelper.mk
include /usr/share/cdbs/1/class/autotools.mk

DEB_CONFIGURE_EXTRA_FLAGS := --enable-cxx --target=$(TARGET) \
	--prefix=/usr/lib/rtems4.7 --with-float=soft \
	--enable-posix --disable-networking --disable-itron \
	--enable-rtemsbsp="$(BSP)"

debian/stamp-bootstrap:
	cp -r debian/mparm-bsp/* build-tree/$(DEB_TAR_SRCDIR)/
	$(RM) -r build-tree/$(DEB_TAR_SRCDIR)/c/src/lib/libbsp/{i386,c4x,h8300,m68k,mips,sh,sparc,no_cpu,powerpc,bare,unix}
	$(RM) -r build-tree/$(DEB_TAR_SRCDIR)/c/src/lib/libcpu/{i386,m68k,mips,sh,sparc,powerpc}
	cd build-tree/$(DEB_TAR_SRCDIR) && ./bootstrap
	touch $@

pre-build:: debian/stamp-bootstrap

clean::
	$(RM) debian/stamp-bootstrap
