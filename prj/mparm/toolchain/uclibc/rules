#!/usr/bin/make -f

TARGET := arm-linux-uclibc

DEB_BUILD_OPTIONS := nocheck nostrip
DEB_TAR_SRCDIR := uClibc

export DEB_BUILD_OPTIONS

include /usr/share/cdbs/1/rules/simple-patchsys.mk
include /usr/share/cdbs/1/rules/tarball.mk
include /usr/share/cdbs/1/rules/debhelper.mk
include /usr/share/cdbs/1/class/makefile.mk

DEB_MAKE_CLEAN_TARGET   := 

DEB_MAKE_BUILD_TARGET   := all CROSS=arm-linux-uclibc- CURDIR=$(CURDIR) \
	PREFIX=/usr/arm-linux-uclibc DEVEL_PREFIX=/ RUNTIME_PREFIX=/ \
	HOSTCC=gcc KERNEL_SOURCE=$(CURDIR)/build-tree/linux-libc-headers-2.4.31

DEB_MAKE_INSTALL_TARGET := install_runtime install_dev PREFIX= \
	RUNTIME_PREFIX=$(CURDIR)/debian/arm-linux-uclibc/usr/arm-linux-uclibc/ \
	DEVEL_PREFIX=$(CURDIR)/debian/arm-linux-uclibc/usr/arm-linux-uclibc/

DEB_MAKE_CHECK_TARGET   :=

DEB_MAKE_INVOKE := $(DEB_MAKE_ENVVARS) make -C $(DEB_BUILDDIR)

configure/arm-linux-uclibc::
	$(RM) -r build-tree/linux-libc-headers-2.4.31/include/asm
	ln -sf asm-armnommu build-tree/linux-libc-headers-2.4.31/include/asm
	ln -sf arch-swarm build-tree/linux-libc-headers-2.4.31/include/asm/arch
	ln -sf proc-armo build-tree/linux-libc-headers-2.4.31/include/asm/proc
	$(MAKE) -C build-tree/uClibc defconfig

binary-install/arm-linux-uclibc::
	sed -i -e "s|$(CURDIR)\/debian\/arm-linux-uclibc||g" debian/arm-linux-uclibc/usr/arm-linux-uclibc/lib/libc.so

