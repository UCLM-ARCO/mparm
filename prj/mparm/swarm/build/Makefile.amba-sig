DEBUGOPTS += -DEXTRAMPRINTDEBUG
PLATFLAGS += -DAMBASIGBUILD -DWITHOUT_OCP
INCDIR    += -I$(SWARMDIR)/amba-sig
CPPSRCS   += amba_sig_builder.cpp amba_sig_signal.cpp amba_sig_target.cpp amba_sig_trace.cpp \
             arbiter.cpp decoder.cpp delayer_hsel.cpp delayer_hwdata.cpp master.cpp \
	     multi1.cpp multi2.cpp multi3.cpp slaving.cpp amba_sig_dma.cpp ocp_to_amba_sig_slave.cpp
VPATH     += $(SWARMDIR)/amba-sig
#String to print during build process
MSGSTRING += "AMBA AHB (signal model)   "

amba-sig: printmessage $(EXE)
