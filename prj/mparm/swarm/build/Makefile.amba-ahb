DEBUGOPTS += -DEXTRAMPRINTDEBUG
PLATFLAGS += -DAMBAAHBBUILD -DWITHOUT_OCP
INCDIR    += -I$(SWARMDIR)/amba-ahb
CPPSRCS   += amba_ahb_bridge.cpp amba_ahb_bridge_mif.cpp amba_ahb_bridge_sif.cpp \
             amba_ahb_dma.cpp amba_ahb_interconnect.cpp amba_ahb_master.cpp amba_ahb_mlicm.cpp \
             amba_ahb_ocp_master.cpp amba_ahb_slave.cpp amba_ahb_traffic_gen.cpp
# amba_ahb_mlicm.cpp
VPATH     += $(SWARMDIR)/amba-ahb
#String to print during build process
MSGSTRING += "AMBA AHB (interface model)   "

amba-ahb: printmessage $(EXE)
